# =========================================================
# Virai Review Card — Environment Variables (EXAMPLE)
# Copy to .env for local development and set the same keys in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env.
# =========================================================

# --- Runtime ---
NODE_ENV=development
# Internal base URL (no trailing slash).
APP_BASE_URL=http://localhost:3000
# Public base URL embedded in the card QR/NFC codes. It MUST be reachable by the
# customer's phone. Production example: https://your-app.vercel.app
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (managed PostgreSQL: Neon or Supabase) ---
# Runtime connection (may be the POOLED connection string).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true
# Unpooled/DIRECT connection used by Prisma Migrate. If you are not using a
# connection pooler, set it equal to DATABASE_URL.
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Admin authentication ---
# Long random string (min 32 chars). Signs the admin session cookie.
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash-password -- "<your-password>"
# In a .env file, escape every '$' as '\$' so dotenv-expand does not strip it.
ADMIN_PASSWORD_HASH=

# --- Google Places API (optional) ---
# When empty, the FREE Maps-URL Place-ID extraction path is used (no API calls,
# no billing). When set, it is used as a fallback for short/opaque links.
GOOGLE_PLACES_API_KEY=

# --- Rate limits ---
RATE_LIMIT_REDIRECT_PER_MINUTE=30
RATE_LIMIT_ACTIVATE_PER_HOUR=5
RATE_LIMIT_ACTIVATION_LOOKUP_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_15_MINUTES=5
